package Excepciones;

/**
 * Excepcion no comprobada que indica que un dato recibido no es valido
 * durante el registro de un empleado.
 */
public class DatoInvalidoException extends RuntimeException {

    /** Crea la excepcion con una descripcion del dato invalido. */
    public DatoInvalidoException(String mensaje) {
        super(mensaje);
    }
}
