public class Analizador_numeros {
    int [] Numeros;
    
    public Analizador_numeros(){
    }
    
    Analizador_numeros(int []Numeros){
        this.Numeros = Numeros;
    }
    public Analizador_numeros(int []Numeros, int n1, int n2,int n3, int n4, int n5, int n6, int n7, int n8 ,int n9, int n10){
        Numeros = new int[]{n1,n2,n3,n4,n5,n6,n7,n8,n9,10};
    }
    public void Encontrar_may_Y_men(){
        if (Numeros == null || Numeros.length == 0) {
            System.out.println("El arreglo está vacío.");
        }

        int mayor = Numeros[0];
        int menor = Numeros[0];

        // Se Recorre el arreglo 
        for (int i = 1; i < Numeros.length; i++) {
            if (Numeros[i] > mayor) {
                mayor = Numeros[i];
            }
            if (Numeros[i] < menor) {
                menor = Numeros[i];
            }
        }

        System.out.println("El número mayor es: " + mayor);
        System.out.println("El número menor es: " + menor);
    } 
}
