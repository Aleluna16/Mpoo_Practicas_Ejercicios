package e2;

import java.util.Scanner;

public class E2 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        double[] listaNotas = new double[20];

        System.out.println("=== REGISTRO DE CALIFICACIONES:) ===");
        System.out.println("por favor indique la calificacion de los alumnos:");

        for (int i = 0; i < listaNotas.length; i++) {
            double nota;
            do {
                System.out.print("Alumno " + (i + 1) + ": ");
                nota = scanner.nextDouble();
                if (nota < 0 || nota > 10) {
                    System.out.println(" intente de nuevo .");
                }
            } while (nota < 0 || nota > 10);
            
            listaNotas[i] = nota;
        }

        Calificaciones gestion = new Calificaciones(listaNotas);

        System.out.println("\n================ REGISTRO ================");
        System.out.printf("Promedio general:   %.2f\n", gestion.calcularPromedio());
        System.out.printf("Calificación máx:  %.2f\n", gestion.obtenerMaximo());
        System.out.printf("Calificación mín:  %.2f\n", gestion.obtenerMinimo());
        System.out.println("Alumnos aprobados: " + gestion.contarAprobados() + " de " + listaNotas.length);
        System.out.println("Alumnos reprobados: " + (listaNotas.length - gestion.contarAprobados()));
        System.out.println("=========================================");

        scanner.close();
    }
}
